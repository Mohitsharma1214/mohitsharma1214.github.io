# ==============================================================================
# SUPABASE DATABASE & ADMIN SECURITY CREDENTIALS
# ==============================================================================
# Get these from: https://supabase.com -> Project Settings -> API
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Default LLM API Keys for Mohit's Neural Twin (can also be configured via in-app UI)
# Groq (Free: https://console.groq.com/keys)
VITE_GROQ_API_KEY=
# Google Gemini (Free: https://aistudio.google.com/apikey)
VITE_GEMINI_API_KEY=

# Web3Forms Email Dispatch Key (https://web3forms.com)
VITE_WEB3FORMS_ACCESS_KEY=
